# =====================================
# Server Configuration
# =====================================
PORT=3000
NODE_ENV=development

# =====================================
# Frontend URL(s) — comma-separated if more than one (e.g. local + prod)
# =====================================
CLIENT_URL=http://localhost:5173

# =====================================
# MongoDB
# =====================================
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# =====================================
# Clerk — verifies the session token the frontend attaches as
# `Authorization: Bearer <token>` (see @clerk/backend's verifyToken).
# Get this from your Clerk dashboard → API Keys → Secret Key.
# =====================================
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY

# =====================================
# AES Encryption
# Must be exactly 32 characters — used to encrypt vault entries at rest.
# =====================================
ENCRYPTION_KEY=

# =====================================
# Optional
# =====================================
PASSWORD_EXPIRY_DAYS=90
