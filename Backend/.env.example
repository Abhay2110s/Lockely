# =====================================
# Server Configuration
# =====================================
PORT=3000
NODE_ENV=development

# =====================================
# Frontend URL(s) — comma-separated if more than one (e.g. local + prod).
# If left empty, the server falls back to localhost origins for local dev.
# =====================================
CLIENT_URL=http://localhost:5173

# =====================================
# MongoDB
# =====================================
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# =====================================
# JWT — sign access tokens with a long random secret
# =====================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_32chars_min
JWT_EXPIRES_IN=7d

# =====================================
# AES Encryption
# Must be exactly 32 characters — used to encrypt vault entries at rest.
# =====================================
ENCRYPTION_KEY=

# =====================================
# SMTP — for OTP / password-reset emails
# Using Gmail: enable "App Passwords" in your Google account security settings
# =====================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Lockely <your_email@gmail.com>"

# =====================================
# Optional
# =====================================
PASSWORD_EXPIRY_DAYS=90
